# ==== KOSMATE :: konfigurasi ====
# copy jadi .env lalu isi

# --- LLM (punya lu sendiri, OpenAI-compatible) ---
LLM_BASE_URL=https://api.teamorouter.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-v4-flash-free
LLM_MODEL_FALLBACK=gemini-3.5-flash-lite

# --- TTS ---
# fish  = Fish Audio (model gratis s2.1-pro-free, butuh reference_id voice)
# edge  = edge-tts (gratis total, tanpa key, suara Indonesia Neural)
TTS_PROVIDER=auto
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
# voice Fish: lihat pilihan dengan `python scripts/fish_voice_set.py --list`
# rekomendasi (perempuan, tenang, conversational): 25bdf652971e49b1b089cecfd4b1f943
FISH_REFERENCE_ID=
# 1 = satu suara saja (tidak pindah provider saat gagal -> timbre tidak berubah)
TTS_STRICT=1
TTS_VOICE=id-ID-GadisNeural
# -20% pelan & halus · -12% pelan · +0% normal
TTS_RATE=-12%
TTS_PITCH=-2Hz
TTS_VOLUME=+0%

# --- STT (dipakai kalau browser gak punya Web Speech API) ---
STT_PROVIDER=auto          # auto | fish | whispercpp | none
STT_LANGUAGE=id
WHISPER_CPP_BIN=
WHISPER_MODEL_PATH=

# --- Persona ---
ASSISTANT_NAME=Kai
USER_NAME=Faa
PERSONA_MODE=temen          # temen | tutor | kerja

# --- Server ---
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
