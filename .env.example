# ==== KOSMATE :: konfigurasi ====
# copy jadi .env lalu isi

# --- LLM (punya lu sendiri, OpenAI-compatible) ---
LLM_BASE_URL=https://api.teamorouter.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-v4-flash-free
LLM_MODEL_FALLBACK=gemini-3.5-flash-lite

# --- TTS ---
# fish  = Fish Audio (model gratis s2.1-pro-free, butuh reference_id voice)
# edge  = edge-tts (gratis total, tanpa key, suara Indonesia Neural)
TTS_PROVIDER=auto
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
FISH_REFERENCE_ID=
TTS_VOICE=id-ID-GadisNeural
TTS_RATE=+0%

# --- STT (dipakai kalau browser gak punya Web Speech API) ---
STT_PROVIDER=auto          # auto | fish | whispercpp | none
STT_LANGUAGE=id
WHISPER_CPP_BIN=
WHISPER_MODEL_PATH=

# --- Persona ---
ASSISTANT_NAME=Kai
USER_NAME=Faa
PERSONA_MODE=temen          # temen | tutor | kerja

# --- Server ---
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
